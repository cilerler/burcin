{
	"$schema": "http://json.schemastore.org/template",
	"author": "Cengiz Ilerler",
	"classifications": ["Web"],
	"identity": "Burcin.BoilerPlate.CSharp",
	"name": "Burcin BoilerPlate",
	"shortName": "burcin",
	"tags": {
		"language": "C#",
		"type": "project"
	},
	"groupIdentity": "Burcin.Templates",
	"preferNameDirectory": true,
	"guids": ["412f3e04-fa62-4566-8e71-3fe15dc33c1c"],
	"PrimaryOutputs":
	[
		{
			"path": "src/BurcinCo.BurcinApp.Data/_BurcinDatabaseDbContext.cs"
		}
	],
	"forms": {
		"lowerCase": {
			"identifier": "lowerCase"
		},
		"upperCase": {
			"identifier": "upperCase"
		}
	},
	"symbols": {
		"OrganizationName": {
			"type": "parameter",
			"datatype": "string",
			"defaultValue": "Company",
			"replaces": "BurcinCo",
			"fileRename": "BurcinCo",
			"description": "Short organization name used in namespaces and folder names (e.g. Acme)"
		},
		"OrganizationNameLower": {
			"type": "derived",
			"valueSource": "OrganizationName",
			"valueTransform": "lowerCase",
			"replaces": "burcinco",
			"description": "Lowercase organization name (e.g. acme)"
		},
		"OrganizationNameUpper": {
			"type": "derived",
			"valueSource": "OrganizationName",
			"valueTransform": "upperCase",
			"replaces": "BURCINCO",
			"description": "Uppercase organization name (e.g. ACME)"
		},
		"OrganizationLegalName": {
			"type": "parameter",
			"datatype": "string",
			"defaultValue": "Company, Inc.",
			"replaces": "BurcinLegal",
			"description": "Full legal entity name for Company and Copyright fields (e.g. Acme, Inc.)"
		},
		"OrganizationLegalNameUpper": {
			"type": "derived",
			"valueSource": "OrganizationLegalName",
			"valueTransform": "upperCase",
			"replaces": "BURCINLEGAL"
		},
		"ProjectName": {
			"type": "parameter",
			"datatype": "string",
			"defaultValue": "App",
			"replaces": "BurcinApp",
			"fileRename": "BurcinApp",
			"description": "The project name (e.g. MyService)"
		},
		"ProjectNameLower": {
			"type": "derived",
			"valueSource": "ProjectName",
			"valueTransform": "lowerCase",
			"replaces": "burcinapp"
		},
		"ProjectNameUpper": {
			"type": "derived",
			"valueSource": "ProjectName",
			"valueTransform": "upperCase",
			"replaces": "BURCINAPP"
		},
		"Authors": {
			"type": "parameter",
			"datatype": "string",
			"defaultValue": "anonymous",
			"replaces": "(authors)"
		},
		"AuthorsXmlEncoded": {
			"type": "derived",
			"replaces": "(authors-xml-encoded)",
			"valueSource": "Authors",
			"valueTransform": "xmlEncode"
		},
		"RepositoryUrl": {
			"type": "parameter",
			"defaultValue": "https://github.com/cilerler/burcin",
			"replaces": "(repositoryUrl)"
		},
		"RepositoryUrlLower": {
			"type": "derived",
			"valueSource": "RepositoryUrl",
			"valueTransform": "lowerCase",
			"replaces": "(repositoryUrl-lower)"
		},
		"RepositoryUrlXmlEncoded": {
			"type": "derived",
			"replaces": "(repositoryUrl-xml-encoded)",
			"valueSource": "RepositoryUrlLower",
			"valueTransform": "xmlEncode"
		},
		"DatabaseName": {
			"type": "parameter",
			"defaultValue": "WideWorldImporters",
			"replaces": "BurcinDatabase",
			"fileRename": "BurcinDatabase"
		},
		"EntityFramework": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false"
		},
		"OData": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false"
		},
		"Cache": {
			"type": "parameter",
			"datatype": "choice",
			"choices": [
				{
					"choice": "Microsoft SQL Server"
				},
				{
					"choice": "Redis"
				},
				{
					"choice": "All",
					"description": "Support both cache providers"
				},
				{
					"choice": "None",
					"description": "No cache provider"
				}
			],
			"defaultValue": "None"
		},
		"CacheSqlServer": {
			"type": "computed",
			"value": "(Cache == \"Microsoft SQL Server\" || Cache == \"All\")"
		},
		"CacheRedis": {
			"type": "computed",
			"value": "(Cache == \"Redis\" || Cache == \"All\")"
		},
		"CacheExists": {
			"type": "computed",
			"value": "(CacheSqlServer == \"true\" || CacheRedis == \"true\")"
		},
		"DocFx": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false"
		},
		"GitHubTemplates": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false"
		},
		"NugetSourceGitHub": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false"
		},
		"NugetSourceAzureDevOps": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false"
		},
		"NugetSourceExists": {
			"type": "computed",
			"value": "(NugetSourceGitHub == \"true\" || NugetSourceAzureDevOps == \"true\")"
		},
		"SkipRestore": {
			"type": "parameter",
			"datatype": "bool",
			"defaultValue": "false",
			"description": "Skip `dotnet restore`"
		},
		"DockerId": {
			"type": "generated",
			"generator": "guid",
			"replaces": "412f3e04-fa62-4566-8e71-3fe15dc33c1c",
			"parameters": {
				"format": "D"
			}
		},
		"TemplateEditMode": {
			"type": "generated",
			"generator": "constant",
			"parameters": {
				"value": "false"
			}
		}
	},
	"sources": [
		{
			"modifiers": [
				{
					"condition": "(!EntityFramework)",
					"exclude": [
						"tools/EntityFramework/**/*",
						"src/BurcinCo.BurcinApp.Host/DbContextFactory.cs",
						"src/BurcinCo.BurcinApp.Domain/EntityFramework.targets",
						"src/BurcinCo.BurcinApp.Host/EntityFramework.targets",
						"src/BurcinCo.BurcinApp.Models/**/*",
						"src/BurcinCo.BurcinApp.Data/**/*",
						"src/BurcinCo.BurcinApp.Migrations/**/*"
					]
				},
				{
					"condition": "(!DocFx)",
					"exclude": [
						"docs/docfx/**/*",
						"apiSpec/**/*"
					]
				},
				{
					"condition": "(!GitHubTemplates)",
					"exclude": [".github/**/*"]
				},
				{
					"condition": "(!CacheSqlServer)",
					"exclude": ["tools/sql-cache.ps1"]
				},
				{
					"condition": "(!OData)",
					"exclude": [
						"src/BurcinCo.BurcinApp.Data/ODataEdmModelBuilder.cs"
					]
				}
			]
		}
	],
	"postActions": [
		{
			"condition": "(!SkipRestore)",
			"description": "Restore NuGet packages required by this project.",
			"manualInstructions": [{ "text": "Run 'dotnet restore'" }],
			"actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
			"continueOnError": true
		}
	],
	"SpecialCustomOperations": {
		"**/*.ps1": {
			"operations": [
				{
					"type": "conditional",
					"configuration": {
						"if": ["#--if"],
						"else": ["#--else"],
						"elseif": ["#--elseif", "#--elif"],
						"endif": ["#--endif"],
						"trim": "true",
						"wholeLine": "true"
					}
				}
			]
		},
		"**/*.yml": {
			"operations": [
				{
					"type": "conditional",
					"configuration": {
						"if": ["#--if"],
						"else": ["#--else"],
						"elseif": ["#--elseif", "#--elif"],
						"endif": ["#--endif"],
						"trim": "true",
						"wholeLine": "true"
					}
				}
			]
		},
		"**/*.md": {
			"operations": [
				{
					"type": "conditional",
					"configuration": {
						"if": ["<!--#if"],
						"else": ["<!--#else"],
						"elseif": ["<!--#elseif", "<!--#elif"],
						"endif": ["<!--#endif"],
						"trim": "true",
						"wholeLine": "true"
					}
				}
			]
		},
		"**/nuget.config": {
			"operations": [
				{
					"type": "conditional",
					"configuration": {
						"if": ["<!--#if"],
						"else": ["<!--#else"],
						"elseif": ["<!--#elseif", "<!--#elif"],
						"endif": ["<!--#endif"],
						"trim": "true",
						"wholeLine": "true"
					}
				}
			]
		},
		"**/*.targets": {
			"operations": [
				{
					"type": "conditional",
					"configuration": {
						"if": ["<!--#if"],
						"else": ["<!--#else"],
						"elseif": ["<!--#elseif", "<!--#elif"],
						"endif": ["<!--#endif"],
						"trim": "true",
						"wholeLine": "true"
					}
				}
			]
		},
		"**/*.props": {
			"operations": [
				{
					"type": "conditional",
					"configuration": {
						"if": ["<!--#if"],
						"else": ["<!--#else"],
						"elseif": ["<!--#elseif", "<!--#elif"],
						"endif": ["<!--#endif"],
						"trim": "true",
						"wholeLine": "true"
					}
				}
			]
		},
		"**/Dockerfile": {
			"operations": [
				{
					"type": "conditional",
					"configuration": {
						"if": ["#--if"],
						"else": ["#--else"],
						"elseif": ["#--elseif", "#--elif"],
						"endif": ["#--endif"],
						"trim": "true",
						"wholeLine": "true"
					}
				}
			]
		},
		"**/*.http": {
			"operations": [
				{
					"type": "conditional",
					"configuration": {
						"if": ["#--if"],
						"else": ["#--else"],
						"elseif": ["#--elseif", "#--elif"],
						"endif": ["#--endif"],
						"trim": "true",
						"wholeLine": "true"
					}
				}
			]
		}
	}
}
