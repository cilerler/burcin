{
	"$schema": "http://json.schemastore.org/template",
	"author": "Cengiz Ilerler",
	"classifications": ["Web", "Blazor", "MAUI"],
	"identity": "Burcin.BoilerPlate.CSharp",
	"name": "Burcin BoilerPlate",
	"shortName": "burcin",
	"tags": {
		"language": "C#",
		"type": "project"
	},
	"groupIdentity": "Burcin.Templates",
	"preferNameDirectory": true,
	"PrimaryOutputs":
	[
		{
			"condition": "(EntityFrameworkScaffold)",
			"path": "src/BurcinCo.BurcinApp.Data/_BurcinDatabaseDbContext.cs"
		}
	],
	"forms": {
		"lowerCase": {
			"identifier": "lowerCase"
		},
		"upperCase": {
			"identifier": "upperCase"
		}
	},
	"symbols": {
		"OrganizationName": {
			"type": "parameter",
			"datatype": "string",
			"defaultValue": "Company",
			"replaces": "BurcinCo",
			"fileRename": "BurcinCo",
			"description": "Short organization name used in namespaces and folder names (e.g. Acme)"
		},
		"OrganizationNameLower": {
			"type": "derived",
			"valueSource": "OrganizationName",
			"valueTransform": "lowerCase",
			"replaces": "burcinco",
			"description": "Lowercase organization name (e.g. acme)"
		},
		"OrganizationNameUpper": {
			"type": "derived",
			"valueSource": "OrganizationName",
			"valueTransform": "upperCase",
			"replaces": "BURCINCO",
			"description": "Uppercase organization name (e.g. ACME)"
		},
		"OrganizationLegalName": {
			"type": "parameter",
			"datatype": "string",
			"defaultValue": "Company, Inc.",
			"replaces": "BurcinLegal",
			"description": "Full legal entity name for Company and Copyright fields (e.g. Acme, Inc.)"
		},
		"OrganizationLegalNameUpper": {
			"type": "derived",
			"valueSource": "OrganizationLegalName",
			"valueTransform": "upperCase",
			"replaces": "BURCINLEGAL"
		},
		"ProjectName": {
			"type": "parameter",
			"datatype": "string",
			"defaultValue": "App",
			"replaces": "BurcinApp",
			"fileRename": "BurcinApp",
			"description": "The project name (e.g. MyService)"
		},
		"ProjectNameLower": {
			"type": "derived",
			"valueSource": "ProjectName",
			"valueTransform": "lowerCase",
			"replaces": "burcinapp"
		},
		"ProjectNameUpper": {
			"type": "derived",
			"valueSource": "ProjectName",
			"valueTransform": "upperCase",
			"replaces": "BURCINAPP"
		},
		"Authors": {
			"type": "parameter",
			"datatype": "string",
			"defaultValue": "anonymous",
			"replaces": "(authors)"
		},
		"AuthorsXmlEncoded": {
			"type": "derived",
			"replaces": "(authors-xml-encoded)",
			"valueSource": "Authors",
			"valueTransform": "xmlEncode"
		},
		"RepositoryUrl": {
			"type": "parameter",
			"defaultValue": "https://github.com/cilerler/burcin",
			"replaces": "(repositoryUrl)"
		},
		"RepositoryUrlLower": {
			"type": "derived",
			"valueSource": "RepositoryUrl",
			"valueTransform": "lowerCase",
			"replaces": "(repositoryUrl-lower)"
		},
		"RepositoryUrlXmlEncoded": {
			"type": "derived",
			"replaces": "(repositoryUrl-xml-encoded)",
			"valueSource": "RepositoryUrlLower",
			"valueTransform": "xmlEncode"
		},
		"RepositoryUrlMarkdown": {
			"type": "derived",
			"replaces": "https://repository.invalid",
			"valueSource": "RepositoryUrl",
			"valueTransform": "identity"
		},
		"DatabaseName": {
			"type": "parameter",
			"defaultValue": "WideWorldImporters",
			"replaces": "BurcinDatabase",
			"fileRename": "BurcinDatabase"
		},
		"Sample": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false",
			"description": "Include the Recipe, Nutrition, and Sourcing reference modules plus the Gateway-owned Webhook edge adapter. Sourcing demonstrates Outbox/Inbox and supplier webhook ingestion via Ruya. When on, the Data project gains a Ruya.Services.ReliableMessaging dependency and registers Outbox/Inbox in the shared DbContext; when off, Data stays Ruya-free and the reference modules and Webhook edge adapter are not generated. Sample also auto-enables --EntityFramework + --OData (both are required for the demo to function)."
		},
		"EntityFramework": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false",
			"description": "Generate the shared EF Core scaffold (Models, Data, Migrations, and tooling). Reference business modules remain gated by --Sample. Auto-enabled when --Sample is on, since the Sourcing reference module depends on it."
		},
		"OData": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false",
			"description": "Enable OData plumbing for application modules. Recipe and Nutrition reference controllers are present only with --Sample. Auto-enabled when --Sample is on, since the AppHost E2E demo exercises OData CRUD."
		},
		"EntityFrameworkScaffold": {
			"type": "computed",
			"value": "(EntityFramework || Sample)"
		},
		"ODataServices": {
			"type": "computed",
			"value": "(OData || Sample)"
		},
		"Web": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false",
			"description": "Generate the Blazor Web client runner and its shared Razor Class Library."
		},
		"Maui": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false",
			"description": "Generate the .NET MAUI Blazor Hybrid client runner and its shared Razor Class Library."
		},
		"ClientShared": {
			"type": "computed",
			"value": "(Web || Maui)"
		},
		"Cache": {
			"type": "parameter",
			"datatype": "choice",
			"choices": [
				{
					"choice": "Microsoft SQL Server"
				},
				{
					"choice": "Redis"
				},
				{
					"choice": "All",
					"description": "Support both cache providers"
				},
				{
					"choice": "None",
					"description": "No cache provider"
				}
			],
			"defaultValue": "None"
		},
		"CacheSqlServer": {
			"type": "computed",
			"value": "(Cache == \"Microsoft SQL Server\" || Cache == \"All\")"
		},
		"CacheRedis": {
			"type": "computed",
			"value": "(Cache == \"Redis\" || Cache == \"All\")"
		},
		"CacheExists": {
			"type": "computed",
			"value": "(CacheSqlServer == \"true\" || CacheRedis == \"true\")"
		},
		"DocFx": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false",
			"description": "Generate a modern searchable DocFX site for the repository documentation and curated managed .NET API reference. Opt in with --DocFx; authored Markdown documentation is always generated."
		},
		"GitHubTemplates": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false"
		},
		"NugetSourceGitHub": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false"
		},
		"NugetSourceAzureDevOps": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false"
		},
		"NugetSourceExists": {
			"type": "computed",
			"value": "(NugetSourceGitHub == \"true\" || NugetSourceAzureDevOps == \"true\")"
		},
		"SkipRestore": {
			"type": "parameter",
			"datatype": "bool",
			"defaultValue": "false",
			"description": "Skip `dotnet restore`"
		},
		"MauiPhoneProductId": {
			"type": "generated",
			"generator": "guid",
			"replaces": "412f3e04-fa62-4566-8e71-3fe15dc33c1c",
			"description": "Generated Windows PhoneProductId for the MAUI package manifest.",
			"parameters": {
				"format": "D"
			}
		},
		"AdrStampSource": {
			"type": "generated",
			"generator": "now",
			"parameters": {
				"format": "yyyyMMddHHmm"
			}
		},
		"AdrStamp": {
			"type": "derived",
			"valueSource": "AdrStampSource",
			"valueTransform": "identity",
			"replaces": "000000000000",
			"fileRename": "000000000000"
		},
		"AdrDate": {
			"type": "generated",
			"generator": "now",
			"replaces": "0000-00-00",
			"parameters": {
				"format": "yyyy-MM-dd"
			}
		},
		"TemplateEditMode": {
			"type": "generated",
			"generator": "constant",
			"parameters": {
				"value": "false"
			}
		}
	},
	"sources": [
		{
			"modifiers": [
				{
					"condition": "(!ClientShared)",
					"exclude": ["src/BurcinCo.BurcinApp.Client.Shared/**/*"]
				},
				{
					"condition": "(!Web)",
					"exclude": [
						"src/BurcinCo.BurcinApp.Client.Web/**/*",
						"tests/BurcinCo.BurcinApp.Client.Web.Integration.Tests/**/*"
					]
				},
				{
					"condition": "(!Maui)",
					"exclude": ["src/BurcinCo.BurcinApp.Client.Maui/**/*"]
				},
				{
					"condition": "(!Sample)",
					"exclude": [
						"src/BurcinCo.BurcinApp.Modules.Recipe/**/*",
						"src/BurcinCo.BurcinApp.Modules.Recipe.Abstractions/**/*",
						"src/BurcinCo.BurcinApp.Modules.Nutrition/**/*",
						"src/BurcinCo.BurcinApp.Modules.Sourcing/**/*",
						"src/BurcinCo.BurcinApp.Modules.Sourcing.Abstractions/**/*",
						"src/BurcinCo.BurcinApp.Gateway/Webhook/**/*",
						"tests/BurcinCo.BurcinApp.Gateway.Integration.Tests/WebhookTests.cs",
						"tests/BurcinCo.BurcinApp.Gateway.Integration.Tests/Fixtures/BrokerCallRecorder.cs",
						"tests/BurcinCo.BurcinApp.Gateway.Integration.Tests/Fixtures/NoContentLengthHttpContent.cs",
						"tests/BurcinCo.BurcinApp.AppHost.E2E.Tests/ODataCrudTests.cs",
						"tests/BurcinCo.BurcinApp.AppHost.E2E.Tests/Fixtures/DatabaseSchemaInitializer.cs",
						"tests/BurcinCo.BurcinApp.Modules.Recipe.Integration.Tests/**/*",
						"tests/BurcinCo.BurcinApp.Modules.Nutrition.Integration.Tests/**/*",
						"tests/BurcinCo.BurcinApp.Modules.Sourcing.Integration.Tests/**/*",
						"tests/Chef.http",
						"tests/Recipe.http",
						"tests/CategoryCode.http",
						"tests/CategoryGroup.http",
						"tests/CategoryCodeGroupMapping.http",
						"tests/NutritionFact.http",
						"tests/Tag.http",
						"tests/Photo.http",
						"tests/IngredientSupply.http",
						"tests/Batch.http"
					]
				},
				{
					"condition": "(!EntityFrameworkScaffold)",
					"exclude": [
						"tools/EntityFramework/**/*",
						"src/BurcinCo.BurcinApp.Models/**/*",
						"src/BurcinCo.BurcinApp.Data/**/*",
						"src/BurcinCo.BurcinApp.Migrations/**/*"
					]
				},
				{
					"condition": "(!DocFx)",
					"exclude": [
						".config/dotnet-tools.json",
						".github/workflows/documentation.yml",
						"docs/docfx/**/*",
						"tools/documentation.ps1"
					]
				},
				{
					"condition": "(!GitHubTemplates)",
					"exclude": [".github/**/*"]
				},
				{
					"condition": "(!CacheSqlServer)",
					"exclude": ["tools/sql-cache.ps1"]
				},
				{
					"condition": "(!ODataServices)",
					"exclude": [
						"src/BurcinCo.BurcinApp.Data/ODataExtensions.cs",
						"src/BurcinCo.BurcinApp.Modules.Recipe/Catalog/Chef/Api/ChefController.cs",
						"src/BurcinCo.BurcinApp.Modules.Recipe/Catalog/Recipe/Api/RecipeController.cs",
						"src/BurcinCo.BurcinApp.Modules.Recipe/Catalog/Recipe/Models/RecipeSummary.cs",
						"src/BurcinCo.BurcinApp.Modules.Recipe/Catalog/Category/Api/CategoryCodeController.cs",
						"src/BurcinCo.BurcinApp.Modules.Recipe/Catalog/Category/Api/CategoryGroupController.cs",
						"src/BurcinCo.BurcinApp.Modules.Recipe/Catalog/Category/Api/CategoryCodeGroupMappingController.cs",
						"src/BurcinCo.BurcinApp.Modules.Recipe/Catalog/Tag/Api/TagController.cs",
						"src/BurcinCo.BurcinApp.Modules.Recipe/Catalog/ConcurrencyCheck.cs",
						"src/BurcinCo.BurcinApp.Modules.Recipe/Extensions/ODataExtensions.cs",
						"src/BurcinCo.BurcinApp.Modules.Nutrition/Tracking/NutritionFact/Api/NutritionFactController.cs",
						"src/BurcinCo.BurcinApp.Modules.Nutrition/Tracking/ConcurrencyCheck.cs",
						"tests/Chef.http",
						"tests/Recipe.http",
						"tests/CategoryCode.http",
						"tests/CategoryGroup.http",
						"tests/CategoryCodeGroupMapping.http",
						"tests/NutritionFact.http",
						"tests/Tag.http",
						"tests/Batch.http"
					]
				}
			]
		}
	],
	"postActions": [
		{
			"condition": "(!SkipRestore)",
			"description": "Restore NuGet packages required by this project.",
			"manualInstructions": [{ "text": "Run 'dotnet restore'" }],
			"actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
			"continueOnError": true
		}
	],
	"SpecialCustomOperations": {
		"**/*.ps1": {
			"operations": [
				{
					"type": "conditional",
					"configuration": {
						"if": ["#--if"],
						"else": ["#--else"],
						"elseif": ["#--elseif", "#--elif"],
						"endif": ["#--endif"],
						"trim": "true",
						"wholeLine": "true"
					}
				}
			]
		},
		"**/*.yml": {
			"operations": [
				{
					"type": "conditional",
					"configuration": {
						"if": ["#--if"],
						"else": ["#--else"],
						"elseif": ["#--elseif", "#--elif"],
						"endif": ["#--endif"],
						"trim": "true",
						"wholeLine": "true"
					}
				}
			]
		},
		"**/*.md": {
			"operations": [
				{
					"type": "conditional",
					"configuration": {
						"if": ["<!--#if"],
						"else": ["<!--#else"],
						"elseif": ["<!--#elseif", "<!--#elif"],
						"endif": ["<!--#endif"],
