{
	"Logging": {
		"LogLevel": {
			"Default": "Trace"
		},
		// Resource monitoring remains enabled for health checks and metrics. Override these provider-specific
		// category levels to Debug or Trace temporarily when per-sample diagnostics are needed.
		"Debug": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace",
				"Microsoft.Extensions.Diagnostics.ResourceMonitoring": "Information"
			}
		},
		"Console": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace",
				"Microsoft.Extensions.Diagnostics.ResourceMonitoring": "Information"
			}
		},
		"OpenTelemetry": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace",
				"Microsoft.Extensions.Diagnostics.ResourceMonitoring": "Information"
			}
		}
	},

  "EnvironmentVariablesPrefix": "BURCINCO_",
  "DistributedTracing": {
    "CacheSlidingExpiration": "1.00:00:00",
    "CacheAbsoluteExpiration": "1.00:00:00"
  },
  "OpenTelemetry": {
    "Meters": [
      //#if (Sample)
      "BurcinCo.BurcinApp.Gateway.Webhook",
      //#endif
      "Ruya.Diagnostics.DistributedTracing"
    ],
    "Sql": {
      "RecordException": false
    }
  },
  "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector:4317",
	"FeatureManagement": {
		//#if (Sample)
		// Gateway edge-capability activation is captured once and gates both DI registration and mapping.
		"Gateway.Webhook": true,
		//#endif
		"AppEnvironmentResponseHeaders": true
  },
  //#if (Sample)
  "RabbitMq": {
    "ManagementConnectionStringKey": "RabbitMqManagement"
  },
  "Gateway": {
    "Webhook": {
      "VHost": "%2F",
      "MaxBodyBytes": 1048576,
      "PublishTimeout": "00:00:10"
    },
    "WebhookAuth": {
      "Required": true,
      "HeaderName": "X-Webhook-Secret"
    }
  },
  //#endif
  "ReverseProxy": {
    "Routes": {
      //#if (Web)
      "portal-route": {
        "ClusterId": "portal",
        "Match": {
          "Path": "/portal/{**catch-all}"
        }
      },
      //#endif
      "host-route": {
        "ClusterId": "host",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "host": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "host-1": {
            "Address": "https+http://host"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/healthz"
          }
        }
      }
      //#if (Web)
      ,
      "portal": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "portal-1": {
            "Address": "https+http://client-web"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/healthz/live"
          }
        }
      }
      //#endif
    }
  }
}
