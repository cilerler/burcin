{
	"Logging": {
		"LogLevel": {
			"Default": "Trace"
		},
		// Resource monitoring remains enabled for health checks and metrics. Override these provider-specific
		// category levels to Debug or Trace temporarily when per-sample diagnostics are needed.
		"Debug": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace",
				"Microsoft.Extensions.Diagnostics.ResourceMonitoring": "Information"
			}
		},
		"Console": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace",
				"Microsoft.Extensions.Diagnostics.ResourceMonitoring": "Information"
			}
		},
		"OpenTelemetry": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace",
				"Microsoft.Extensions.Diagnostics.ResourceMonitoring": "Information"
			}
		}
	},

  "EnvironmentVariablesPrefix": "BURCINCO_",
  "DistributedTracing": {
    "CacheSlidingExpiration": "1.00:00:00",
    "CacheAbsoluteExpiration": "1.00:00:00"
  },
  "OpenTelemetry": {
    "ActivitySources": [
      "Yarp.ReverseProxy"
    ],
    "Meters": [
      "Microsoft.AspNetCore.RateLimiting",
      //#if (Sample)
      "BurcinCo.BurcinApp.Gateway.Webhook",
      //#endif
      "Ruya.Diagnostics.DistributedTracing"
    ],
    "Sql": {
      "RecordException": false
    }
  },
  "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector:4317",
	"FeatureManagement": {
		//#if (Sample)
		// Gateway edge-capability activation is captured once and gates both DI registration and mapping.
		"Gateway.Webhook": true,
		//#endif
		"AppEnvironmentResponseHeaders": true
  },
  //#if (Sample)
  "RabbitMq": {
    "ManagementConnectionStringKey": "RabbitMqManagement"
  },
  //#endif
  "Gateway": {
    "RateLimiting": {
      "Proxy": {
        "TokenLimit": 200,
        "TokensPerPeriod": 50,
        "ReplenishmentPeriod": "00:00:05",
        "QueueLimit": 0
      },
      "Webhook": {
        "TokenLimit": 30,
        "TokensPerPeriod": 10,
        "ReplenishmentPeriod": "00:00:10",
        "QueueLimit": 0
      }
    },
    "NetworkSecurity": {
      "ForwardedHeaders": {
        "Enabled": false,
        "ForwardLimit": 1,
        "KnownProxies": [],
        "KnownNetworks": []
      },
      "IpSafelists": {
        "gateway-operations-ip-safelist": {
          "Enabled": false,
          "AllowedNetworks": []
        },
        "gateway-proxy-ip-safelist": {
          "Enabled": false,
          "AllowedNetworks": []
        },
        "gateway-webhook-ip-safelist": {
          "Enabled": false,
          "AllowedNetworks": []
        }
      }
    }
    //#if (Sample)
    ,
    "Webhook": {
      "VHost": "%2F",
      "MaxBodyBytes": 1048576,
      "PublishTimeout": "00:00:10"
    },
    "WebhookAuth": {
      "Required": true,
      "HeaderName": "X-Webhook-Secret"
    }
    //#endif
  },
  "ReverseProxy": {
    "Routes": {
      //#if (Web)
      "portal-route": {
        "ClusterId": "portal",
        "AuthorizationPolicy": "gateway-proxy-ip-safelist",
        "RateLimiterPolicy": "gateway-proxy",
        "Match": {
          "Path": "/portal/{**catch-all}"
        }
      },
      //#endif
      "host-route": {
        "ClusterId": "host",
        "AuthorizationPolicy": "gateway-proxy-ip-safelist",
        "RateLimiterPolicy": "gateway-proxy",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "host": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "host-1": {
            "Address": "https+http://host"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/healthz"
          }
        }
      }
      //#if (Web)
      ,
      "portal": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "portal-1": {
            "Address": "https+http://client-web"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/healthz/live"
          }
        }
      }
      //#endif
    }
  }
}
