{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "EnvironmentVariablesPrefix": "BURCINCO_",
  "ConnectionStrings": {
    "RabbitMqManagement": "http://guest:guest@rabbitmq:15672"
  },
  "RabbitMq": {
    "ManagementConnectionStringKey": "RabbitMqManagement"
  },
  "Gateway": {
    "Webhook": {
      "VHost": "%2F",
      "Exchange": "amq.default",
      "MaxBodyBytes": 1048576,
      "PublishTimeout": "00:00:10"
    },
    "WebhookAuth": {
      "Enabled": true,
      "Required": true,
      "HeaderName": "X-Webhook-Secret",
      "Secret": null
    }
  },
  "DistributedTracing": {
    "CacheSlidingExpiration": "1.00:00:00"
  },
  "OpenTelemetry": {
    "Sql": {
      "RecordException": false
    }
  },
  "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://host.docker.internal:18889",
  "ReverseProxy": {
    "Routes": {
      "portal-route": {
        "ClusterId": "portal",
        "Match": {
          "Path": "/portal/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/portal" }
        ]
      },
      "host-route": {
        "ClusterId": "host",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "host": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "host-1": {
            "Address": "https+http://host"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/healthz"
          }
        }
      },
      "portal": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "portal-1": {
            "Address": "https+http://host"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": "true",
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/healthz"
          }
        }
      }
    }
  }
}
