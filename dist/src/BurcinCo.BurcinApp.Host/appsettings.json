{
	"Logging": {
		"LogLevel": {
			"Default": "Trace"
		},
		"Debug": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace"
			}
		},
		"Console": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace"
			}
		},
		"OpenTelemetry": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace"
			}
		}
	},
	"AllowedHosts": "*",
	"EnvironmentVariablesPrefix": "BURCINCO_",
	"DistributedTracing": {
		"CacheSlidingExpiration": "1.00:00:00"
	},
	"OpenTelemetry": {
		"Sql": {
			"RecordException": false
		}
	},
	//#if (CacheSqlServer || CacheRedis)
	"DistributedCache": {
		//#if (CacheSqlServer)
		"SqlServer": {
			"ConnectionStringKey": "MsSqlCacheConnection",
			"SchemaName": "cache",
			"TableName": "BurcinCo.BurcinApp"
		},
		//#endif
		//#if (CacheRedis)
		"Redis": {
			"ConnectionStringKey": "RedisConnection",
			"InstanceName": "BurcinCo.BurcinApp:",
			"SyncTimeout": "00:00:15"
		}
		//#endif
	},
	//#endif
	"Database": {
		"SqlServerOptions": {
			"CommandTimeoutSeconds": 120
		}
	},
	"BulkInsertOperations": {
		"Timeout": 300,
		"BatchSize": 1000
	},
	"DistributedLock:Redis": {
		"ConnectionStringKey": "RedisConnection"
	},
	"FeatureManagement": {
		"AppEnvironmentResponseHeaders": true
	}
}
