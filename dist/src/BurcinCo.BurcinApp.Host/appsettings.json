{
	"Logging": {
		"LogLevel": {
			"Default": "Trace"
		},
		"Debug": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace"
			}
		},
		"Console": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace"
			}
		},
		"OpenTelemetry": {
			"IncludeScopes": true,
			"LogLevel": {
				"Default": "Trace"
			}
		}
	},
	"AllowedHosts": "*",
	"EnvironmentVariablesPrefix": "BURCINCO_",
	"DistributedTracing": {
		"CacheSlidingExpiration": "1.00:00:00"
	},
	"OpenTelemetry": {
		//#if (CacheRedis)
		"ActivitySources": [
			"Ruya.Services.DistributedLock"
		],
		//#endif
		"Meters": [
			//#if (Sample)
			"BurcinCo.BurcinApp.Modules.Sourcing.Procurement.IngredientSupply",
			//#endif
			"Ruya.Diagnostics.DistributedTracing"
		],
		"Sql": {
			"RecordException": false
		}
	},
	//#if (CacheSqlServer || CacheRedis)
	"DistributedCache": {
		//#if (CacheSqlServer)
		"SqlServer": {
			"ConnectionStringKey": "MsSqlCacheConnection",
			"SchemaName": "cache",
			"TableName": "BurcinCo.BurcinApp"
		},
		//#endif
		//#if (CacheRedis)
		"Redis": {
			"ConnectionStringKey": "RedisConnection",
			"InstanceName": "BurcinCo.BurcinApp:",
			"SyncTimeout": "00:00:15"
		}
		//#endif
	},
	//#endif
	//#if (EntityFrameworkScaffold)
	"Database": {
		"SqlServerOptions": {
			"CommandTimeoutSeconds": 120
		}
	},
	"BulkInsertOperations": {
		"Timeout": 300,
		"BatchSize": 1000
	},
	//#endif
	//#if (Sample)
	"MessageQueue": {
		"DefaultProvider": "default",
		"EnableTelemetry": true,
		"EnableHealthChecks": true,
		"Providers": {
			"default": {
				"Type": "RabbitMQ",
				"Enabled": true
			},
			"sourcing-rabbitmq": {
				"Type": "RabbitMQ",
				"Enabled": true
			}
		}
	},
	"ReliableMessaging": {
		"MessageQueueDispatcher": {
			"QueueName": "default"
		}
	},
	//#endif
	//#if (CacheRedis)
	"DistributedLock:Redis": {
		"ConnectionStringKey": "RedisConnection"
	},
	//#endif
	//#if (Sample)
	// Non-secret capability configuration belongs in the shared base. Environment-specific supplier
	// URLs and credentials merge into this section from appsettings.{Environment}.json or secrets.
	"Modules": {
		"Sourcing": {
			"Procurement": {
				"IngredientSupply": {
					"MessageQueueProviderName": "sourcing-rabbitmq",
					"IngredientQuoteRequestedEventTopicName": "sourcing.ingredient-quote.requested",
					"IngredientQuoteResponseReceivedEventTopicName": "webhooks.sourcing.quote-response"
				}
			}
		}
	},
	//#endif
	"FeatureManagement": {
		//#if (Sample)
		// Module activation flags. Default-on in dev so a single image runs every module locally.
		// Per-deployment Kustomize/Helm overlays flip these off to produce per-module deployment images.
		"Modules.Recipe": true,
		"Modules.Nutrition": true,
		"Modules.Sourcing": true,
		//#endif
		"AppEnvironmentResponseHeaders": true
	}
}
