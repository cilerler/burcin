{
	"Logging": {
		"Console": {
			"LogLevel": {
				"Default": "Error",
				"System": "Error",
				"Microsoft": "Error",
				"Microsoft.Hosting.Lifetime": "Information",
				"Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
				"Polly": "Critical",
				"BurcinCo": "Debug",
				"Ruya.AspNetCore.Middleware.AppEnvironmentResponseHeaders.AppEnvironmentResponseHeadersMiddleware": "Information"
			},
			"FormatterName": "json",
			"FormatterOptions": {
				"IncludeScopes": true,
				"UseUtcTimestamp": true,
				"TimestampFormat": "yyyyMMddHHmmss",
				"JsonWriterOptions": {
					"Indented": false
				}
			}
		}
	}
}
