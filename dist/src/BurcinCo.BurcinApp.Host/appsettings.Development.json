{
	"ConnectionStrings": {
		//#if (EntityFrameworkScaffold)
		"MsSqlConnection": "Server=host.docker.internal,1433;Database=BurcinDatabase;User Id=app-burcinapp;Password=passwordadmin;TrustServerCertificate=false;Encrypt=true;App=BurcinCo.BurcinApp.Host",
		//#endif
		//#if (CacheSqlServer)
		"MsSqlCacheConnection": "Server=host.docker.internal,1433;Database=BurcinDatabase;User Id=distributedCache;Password=passwordadmin;TrustServerCertificate=false;Encrypt=true;App=BurcinCo.BurcinApp.Host",
		//#endif
		//#if (CacheRedis)
		"RedisConnection": "host.docker.internal:6379,password=passwordadmin",
		//#endif
		"RabbitMqConnection": "amqp://useradmin:passwordadmin@host.docker.internal:5672",
		"ApiEndPoint": "http://host.docker.internal:5000"
	},
	// MessageQueue.RabbitMQ uses localhost (not host.docker.internal) because the Host runs as a Windows
	// process under Aspire — Aspire publishes the RabbitMQ container's port to localhost. The connection
	// string above (RabbitMqConnection) keeps host.docker.internal for clients that consume the URL form
	// directly. For docker-compose / k8s deployments, override these MessageQueue:RabbitMQ values per env.
	"MessageQueue": {
		"RabbitMQ": {
			"Host": "127.0.0.1",
			"Port": 5672,
			"VirtualHost": "/",
			"Username": "useradmin",
			"Password": "passwordadmin"
		}
	},
	// Reliable-messaging tuning. Ruya's OutboxProcessor polls the dbo.Outbox table on each PollInterval;
	// the default (1s) is the right call for sub-second-latency workloads but produces 86,400 polls/day per
	// process and clutters dev logs with a SELECT every second. 5s in dev keeps the demo flow snappy without
	// the noise. Tighten back to 1s in environments where outbox-to-broker latency matters.
	// Note: Ruya doesn't yet support adaptive backoff (see its README); fixed interval is the only knob today.
	"ReliableMessaging": {
		"Outbox": {
			"PollInterval": "00:00:05"
		}
	},
	// Per-module configuration. The Sourcing module's IngredientSupply service expects a Suppliers map
	// keyed by SupplierKey; the QuoteRequestDispatcher worker resolves URL + secret from this list.
	"Modules": {
		"Sourcing": {
			"Procurement": {
				"IngredientSupply": {
					"MessageQueueProviderName": "default",
					"Clients": {
						"Suppliers": {
							// RequestBin-style sink for dev. Replace the UUID with one from
							// https://webhook.site or https://requestbin.com to observe outbound payloads.
							"flour-provider": {
								"Url": "https://webhook.site/00000000-0000-0000-0000-000000000000",
								"Secret": "change-me"
							}
						}
					}
				}
			}
		}
	},
	// Gateway config (only relevant when this deployment runs the Gateway role; published webhook
	// inbound payloads land on the routing key `webhooks.{path-with-dots}` on the configured exchange).
	"Gateway": {
		"Webhook": {
			"VHost": "%2F",
			"Exchange": "webhooks"
		}
	},
	"Logging": {
		"LogLevel": {
			"Polly": "Critical"
		},
		"Debug": {
			"LogLevel": {
				"Default": "Critical"
			}
		},
		"OpenTelemetry": {
			"LogLevel": {
				"Default": "Trace",
				"System": "Warning",
				"Microsoft": "Warning",
				"Ruya": "Trace",
				"BurcinCo": "Trace",
				"Ruya.AspNetCore.Middleware.AppEnvironmentResponseHeaders.AppEnvironmentResponseHeadersMiddleware": "Information"
			}
		},
		"Console": {
			"LogLevel": {
				"Default": "Trace",
				"System": "Trace",
				"Microsoft": "Trace",
				"Ruya": "Trace",
				"BurcinCo": "Trace",
				"Ruya.AspNetCore.Middleware.AppEnvironmentResponseHeaders.AppEnvironmentResponseHeadersMiddleware": "Information",
				"Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None",
				"Microsoft.AspNetCore.HostFiltering.HostFilteringMiddleware": "Warning",
				"Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
				"Microsoft.AspNetCore.Mvc.ModelBinding.ModelBinderFactory": "Warning",
				"Microsoft.AspNetCore.Server.Kestrel": "Warning",
				"Microsoft.AspNetCore.ResponseCaching.ResponseCachingMiddleware": "Warning",
				"Microsoft.AspNetCore.ResponseCompression.ResponseCompressionProvider": "Warning",
				"Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
				"Microsoft.AspNetCore.Routing.EndpointRoutingMiddleware": "Warning",
				"Microsoft.AspNetCore.Routing.Matching.DfaMatcher": "Warning",
				"Microsoft.AspNetCore.Server.Kestrel.Connections": "Warning",
				"Microsoft.AspNetCore.Server.Kestrel.Https.Internal.HttpsConnectionMiddleware": "Warning",
				"Microsoft.AspNetCore.StaticFiles.StaticFileMiddleware": "Error",
				"Microsoft.Extensions.Diagnostics.HealthChecks.DefaultHealthCheckService": "Warning",
				"Microsoft.Extensions.Diagnostics.ResourceMonitoring": "Warning",
				"Microsoft.Extensions.Hosting.Internal.Host": "Warning",
				"Microsoft.Hosting.Lifetime": "Information"
			},
			"FormatterName": "simple",
			"FormatterOptions": {
				"IncludeScopes": true,
				"UseUtcTimestamp": true,
				"TimestampFormat": "MM/dd/yyyy HH:mm:ss ",
				"SingleLine": false,
				"ColorBehavior": "Enabled"
			}
		}
	},
	"OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
	"OTEL_EXPORTER_OTLP_ENDPOINT": "http://host.docker.internal:18889", // default 4317 grpc, 4318 http/protobuf
	"OpenTelemetry": {
		"Sql": {
			"RecordException": true
		}
	},
	"FeatureManagement": {
		"AppEnvironmentResponseHeaders": true,
		// Module activation flags. Default-on in dev so a single image runs every module locally.
		// Per-deployment overlays flip these off to produce per-module deployment images.
		"Modules.Recipe": true,
		"Modules.Nutrition": true,
		"Modules.Sourcing": true
	}
}
