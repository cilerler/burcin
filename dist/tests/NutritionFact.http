# NutritionFact is keyed by RecipeId (one fact per recipe). The OData URL form
# /odata/NutritionFact/123 treats 123 as the RecipeId.
# POST validates the referenced Recipe exists (404 returned if not — cross-module FK check
# via IRecipeService, which is in-process when Recipe is in the same deployment, HTTP otherwise).
@host = 127.0.01:443
@baseUrl = https://{{host}}/odata
@entitySet = NutritionFact
@finalUrl = {{baseUrl}}/{{entitySet}}

###
# @name GetMetadata
GET {{baseUrl}}/$metadata HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name CreateRecord
POST {{finalUrl}} HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"RecipeId": 1,
	"CaloriesPerYield": 650,
	"ProteinGrams": 28,
	"CarbsGrams": 70,
	"FatGrams": 30,
	"FiberGrams": 5,
	"SodiumMilligrams": 800
}

###
# @name CreateWithMissingRecipe (expect 404)
POST {{finalUrl}} HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"RecipeId": 99999999,
	"CaloriesPerYield": 1,
	"ProteinGrams": 1,
	"CarbsGrams": 1,
	"FatGrams": 1
}

###
# @name ReadAllRecords
GET {{finalUrl}} HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name ReadByRecipeId
GET {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name UpdateRecord (partial — only Calories)
PATCH {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"CaloriesPerYield": 700
}

###
# @name FullyUpdateRecord
PUT {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"RecipeId": 1,
	"CaloriesPerYield": 720,
	"ProteinGrams": 30,
	"CarbsGrams": 75,
	"FatGrams": 32,
	"FiberGrams": 6,
	"SodiumMilligrams": 750
}

###
# @name DeleteRecord
DELETE {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache
