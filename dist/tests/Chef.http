# Aspire Gateway is fronted on https://localhost:443; it forwards everything to the `host` resource.
# All entity CRUD goes through the OData controllers under /odata/<EntitySet>.
@host = 127.0.01:443
@baseUrl = https://{{host}}/odata
@entitySet = Chef
@finalUrl = {{baseUrl}}/{{entitySet}}

###
# @name GetMetadata
GET {{baseUrl}}/$metadata HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name CreateRecord
POST {{finalUrl}} HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Name": "Test Chef",
	"Url": "https://example.com/"
}

###
# @name ReadAllRecords
GET {{finalUrl}} HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name ReadRecordById
GET {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

# ====================================================================== Can not update SoftDelete record after the value set to `true`

###
# @name UpdateRecord (partial — only Url)
PATCH {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Url": "https://ilerler.info/"
}

###
# @name FullyUpdateRecord
PUT {{finalUrl}}/2 HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Id": 2,
	"Name": "King Arthur Flour",
	"Url": "https://www.youtube.com/user/KingArthurFlour/"
}

###
# @name DeleteRecord
DELETE {{finalUrl}}/3 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

# ===== ALTERNATIVE READS

###
# @name GetTotalRecordCount
GET {{finalUrl}}?$count=true&$top=0 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name GetFirstRecord
GET {{finalUrl}}?$top=1 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name GetSecondRecord
GET {{finalUrl}}?$skip=1&$top=1 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name GetLastThreeRecordIdsWithAuditDates
GET {{finalUrl}}?$count=true&$top=3&$orderby=Id desc&$select=Id,CreatedAt,ModifiedAt HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name GetFirstActiveRecord
GET {{finalUrl}}?$top=1&$filter=not (SoftDelete eq true) HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name FilterWithAnd
GET {{finalUrl}}?$count=true&$filter=Name eq 'Test Chef' and Url eq 'https://example.com' HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name FilterWithOr
GET {{finalUrl}}?$count=true&$filter=Url eq 'https://ilerler.info/' or Url eq 'https://cengiz.dev' HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name FilterWithIn
GET {{finalUrl}}?$count=true&$filter=Url in ('https://ilerler.info/','https://cengiz.dev') HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name FilterWithContains
GET {{finalUrl}}?$top=1&$filter=Name eq 'Test Chef' and contains(Url,'http') HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name GetRecordWithRelatedTables
GET {{finalUrl}}?$filter=Id eq 2&$expand=Recipes HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name GetSpecificRecordWithRelatedTables
GET {{finalUrl}}/2?$expand=Recipes HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name GetAggregatedDistinctCountOfField
# $apply with countdistinct returns one row containing the count of distinct Name values.
# Response shape: { "value": [{ "total": <n> }] }.
GET {{finalUrl}}?$apply=aggregate(Name with countdistinct as total) HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name GetGroupedCountOfField
# groupby + aggregate returns one row per distinct Name with its count. Standard "GROUP BY" pattern.
GET {{finalUrl}}?$apply=groupby((Name), aggregate($count as total)) HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name GetCardinalityOfUrl
# Pipeline: filter chefs whose Name contains "Test", group by Url, count distinct Ids, then take
# the top 2 by descending count. NOTE: $filter on aggregate aliases (the original `$filter=total gt
# 100` in the legacy file) belongs INSIDE the $apply pipeline, not outside — outside-$filter runs
# against the entity columns, which don't include the alias.
GET {{finalUrl}}?$apply=filter(contains(Name,'Test'))/groupby((Url), aggregate(Id with countdistinct as total))&$orderby=total desc&$top=2 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name GetRecordWithMultiLevelRelatedTables
# Nested $expand: Chef → Recipes → CategoryCodeNavigation. The navigation property on Recipe
# pointing at the CategoryCode entity is named `CategoryCodeNavigation` (not `CategoryCode` — that's
# the FK column). Scaffold-output convention: append `Navigation` to disambiguate from the FK column.
GET {{finalUrl}}?$filter=Id eq 1&$expand=Recipes($select=Id,CategoryCode;$expand=CategoryCodeNavigation($select=Name))&$orderby=Id&$select=Id,Name,Url HTTP/1.1
Host: {{host}}
Cache-Control: no-cache
