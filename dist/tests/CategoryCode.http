@host = 127.0.01:443
@baseUrl = https://{{host}}/odata
@entitySet = CategoryCode
@finalUrl = {{baseUrl}}/{{entitySet}}

###
# @name GetMetadata
GET {{baseUrl}}/$metadata HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name CreateRecord
POST {{finalUrl}} HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Name": "Basics",
	"Code": 1
}

###
# @name ReadAllRecords
GET {{finalUrl}} HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name ReadRecordById
GET {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name UpdateRecord (partial — only Name)
PATCH {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Name": "Essentials"
}

###
# @name FullyUpdateRecord
PUT {{finalUrl}}/2 HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Id": 2,
	"Name": "Common",
	"Code": 2
}

###
# @name DeleteRecord
DELETE {{finalUrl}}/3 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache
