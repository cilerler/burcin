# Demonstrates the OData CRUD shape over a NON-database entity. The Tag entity lives entirely in
# memory (ConcurrentDictionary inside TagService); there's no DbSet, no migration. The HTTP surface
# is identical to a DB-backed entity — the only thing that differs is what TagService.QueryAll()
# returns (an in-memory IQueryable instead of an EF DbSet).
@host = 127.0.01:443
@baseUrl = https://{{host}}/odata
@entitySet = Tag
@finalUrl = {{baseUrl}}/{{entitySet}}

###
# @name CreateRecord
POST {{finalUrl}} HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Name": "vegan",
	"Color": "#22c55e"
}

###
# @name ReadAllRecords
GET {{finalUrl}} HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name ReadRecordById
GET {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name UpdateRecord (partial — only Color)
PATCH {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Color": "#10b981"
}

###
# @name FullyUpdateRecord
PUT {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Id": 1,
	"Name": "vegan-updated",
	"Color": "#f59e0b"
}

###
# @name FilterByName
GET {{finalUrl}}?$filter=Name eq 'vegan' HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name OrderByCreatedAtDescTopFive
GET {{finalUrl}}?$orderby=CreatedAt desc&$top=5 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name DeleteRecord
DELETE {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache
