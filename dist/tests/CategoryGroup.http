@host = 127.0.01:443
@baseUrl = https://{{host}}/odata
@entitySet = CategoryGroup
@finalUrl = {{baseUrl}}/{{entitySet}}

###
# @name GetMetadata
GET {{baseUrl}}/$metadata HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name CreateRecord
POST {{finalUrl}} HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Name": "Cuisines"
}

###
# @name ReadAllRecords
GET {{finalUrl}} HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name ReadRecordById
GET {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache

###
# @name UpdateRecord (partial)
PATCH {{finalUrl}}/1 HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Name": "Cuisines (Updated)"
}

###
# @name FullyUpdateRecord
PUT {{finalUrl}}/2 HTTP/1.1
Host: {{host}}
Content-Type: application/json; charset=utf-8
Cache-Control: no-cache

{
	"Id": 2,
	"Name": "Cooking Methods"
}

###
# @name DeleteRecord
DELETE {{finalUrl}}/3 HTTP/1.1
Host: {{host}}
Cache-Control: no-cache
