{
	"version": "0.2.0",
	"compounds": [
		//#if (Web)
		{
			"name": "Individual: Gateway + Host + Web",
			"configurations": [
				".NET Core Launch (Gateway)",
				".NET Core Launch (Host)",
				".NET Core Launch (Client Web)"
			],
			"stopAll": true
		},
		//#endif
		//#if (Maui)
		{
			"name": "Individual: Gateway + Host + MAUI",
			"configurations": [
				".NET Core Launch (Gateway)",
				".NET Core Launch (Host)",
				".NET MAUI Launch (Client MAUI)"
			],
			"stopAll": true
		},
		//#endif
		{
			"name": "Individual: Gateway + Host",
			"configurations": [
				".NET Core Launch (Gateway)",
				".NET Core Launch (Host)"
			],
			"stopAll": true
		}
	],
	"configurations": [
		{
			"type": "aspire",
			"request": "launch",
			"name": "Aspire: Launch AppHost",
			"program": "${workspaceFolder}"
		},
		{
			"name": ".NET Core Launch (Gateway)",
			"type": "dotnet",
			"request": "launch",
			"projectPath": "${workspaceFolder}/src/BurcinCo.BurcinApp.Gateway/BurcinCo.BurcinApp.Gateway.csproj"
		},
		{
			"name": ".NET Core Launch (Host)",
			"type": "dotnet",
			"request": "launch",
			"projectPath": "${workspaceFolder}/src/BurcinCo.BurcinApp.Host/BurcinCo.BurcinApp.Host.csproj"
		},
		//#if (Web)
		{
			"name": ".NET Core Launch (Client Web)",
			"type": "dotnet",
			"request": "launch",
			"projectPath": "${workspaceFolder}/src/BurcinCo.BurcinApp.Client.Web/BurcinCo.BurcinApp.Client.Web.csproj"
		},
		//#endif
		//#if (Maui)
		{
			"name": ".NET MAUI Launch (Client MAUI)",
			"type": "maui",
			"request": "launch",
			"project": "${workspaceFolder}/src/BurcinCo.BurcinApp.Client.Maui/BurcinCo.BurcinApp.Client.Maui.csproj",
			"preLaunchTask": "maui: Build"
		},
		//#endif
		{
			"name": ".NET: Attach to Process",
			"type": "coreclr",
			"request": "attach",
			"processId": "${command:pickProcess}"
		}
	]
}
