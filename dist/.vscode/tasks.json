{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/BurcinCo.BurcinApp.AppHost/BurcinCo.BurcinApp.AppHost.csproj",
				"--nologo"
			],
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "run",
			"command": "aspire",
			"type": "process",
			"args": [
				"run"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "stop",
			"command": "aspire",
			"type": "process",
			"args": [
				"stop"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "publish",
			"command": "aspire",
			"type": "process",
			"args": [
				"publish",
				"--non-interactive",
				"--output-path",
				"${workspaceFolder}/artifacts"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		}
	]
}
