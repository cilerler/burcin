{
	//#if (Sample)
	"metadata": [
		{
			"src": [
				{
					"src": "../../src",
					"files": [
						"**/BurcinCo.BurcinApp*.Abstractions.csproj",
						"**/BurcinCo.BurcinApp*.Domain.csproj",
						"**/BurcinCo.BurcinApp*.Extensions.csproj"
					]
				}
			],
			"dest": "api/reference",
			"disableGitFeatures": false,
			"disableDefaultFilter": false
		}
	],
	//#endif
	"build": {
		"content": [
			{
				"files": [
					"index.md",
					"toc.yml"
				]
			},
			{
				"src": "..",
				"files": [
					"**/*.md",
					"**/toc.yml"
				],
				"exclude": [
					"docfx/**",
					"README.md"
				],
				"dest": "docs"
			},
			{
				"files": [
					"api/**/*.yml",
					"api/index.md"
				]
			}
		],
		"resource": [
			{
				"src": "..",
				"files": [
					"**/*"
				],
				"exclude": [
					"docfx/**",
					"**/*.md",
					"**/toc.yml"
				],
				"dest": "docs"
			}
		],
		"overwrite": [
			{
				"files": [
					"overrides/**/*.md"
				]
			}
		],
		"output": "_site",
		"template": [
			"default",
			"modern",
			"templates/burcin"
		],
		"postProcessors": [
			"ExtractSearchIndex"
		],
		"globalMetadata": {
			"_appName": "BurcinCo.BurcinApp",
			"_appTitle": "BurcinCo.BurcinApp Documentation",
			"_appFooter": "Copyright © BurcinLegal — Generated with DocFX.",
			"_enableSearch": "true",
			"_enableNewTab": "true",
			"_lang": "en"
		},
		"markdownEngineName": "markdig",
		"markdownEngineProperties": {
			"markdigExtensions": [
				"Abbreviations",
				"DefinitionLists",
				"Diagrams",
				"FootNotes",
				"TaskLists"
			]
		},
		"disableGitFeatures": false
	}
}
