<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
	<metadata>
		<id>Burcin.Templates.CSharp</id>
		<version>$version$</version>
		<description>
			Boilerplate for .NET 10 server, Blazor Web, and .NET MAUI applications
		</description>
		<authors>Cengiz Ilerler</authors>
		<projectUrl>https://github.com/cilerler/burcin</projectUrl>
		<license type="expression">MIT</license>
		<repository type="git" url="https://github.com/cilerler/burcin.git" />
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<packageTypes>
			<packageType name="Template" />
		</packageTypes>
	</metadata>

	<files>
		<file src="**\dist\**\*" exclude="**\bin\**\*;**\obj\**\*;**\artifacts\**\*;**\*.user;**\*.lock.json;**\.git\**\*;**\Directory.Build.local.props;**\dist\docs\docfx\_site\**\*;**\dist\docs\docfx\api\reference\**\*;**\dist\docs\docfx\api\.manifest" />
	</files>
</package>
